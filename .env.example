# ============================================
# mcp-local-rag Environment Configuration
# ============================================

# ── Database ────────────────────────────────
# Path to LanceDB database directory
DB_PATH=./lancedb/

# ── Embedding Provider ───────────────────────
# Choose embedding provider: 'local' (default) or 'azure'
# local: uses Xenova/all-MiniLM-L6-v2 (offline, 384-dim)
# azure: uses Azure OpenAI text-embedding-3-small (cloud, 1536-dim)
EMBEDDING_PROVIDER=local

# ── Azure OpenAI (required when EMBEDDING_PROVIDER=azure) ───
AZURE_EMBEDDING_API_KEY=your-azure-api-key-here
AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Local Model (used when EMBEDDING_PROVIDER=local) ────────
# HuggingFace model name for local embeddings
MODEL_NAME=Xenova/all-MiniLM-L6-v2

# ── Server ───────────────────────────────────
# Base directory for document ingestion
BASE_DIR=./documents/

# Model cache directory (for local embeddings)
CACHE_DIR=./models/

# Maximum file size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# ── Search Settings ───────────────────────────
# Hybrid search weight (0.0 = vector only, 1.0 = BM25 only, default: 0.6)
RAG_HYBRID_WEIGHT=0.6

# Maximum distance threshold for quality filtering (optional)
# RAG_MAX_DISTANCE=1.0

# Grouping mode: 'similar' or 'related' (optional)
# RAG_GROUPING=similar

# Maximum number of files in search results (optional)
# RAG_MAX_FILES=5

# Minimum chunk length in characters (default: 50)
# CHUNK_MIN_LENGTH=50